                getUserData().workout.logs = getUserData().workout.logs.filter(x => x.id !== id);
                saveAppData();
                renderWorkout();
            }
        }

        /* --- TABUNGAN NAVIGATION & SUBVIEWS --- */
        function switchTabunganSub(subId) {
            appState.activeTabunganSub = subId;
            ['dashboard', 'transaksi', 'sumber', 'grafik'].forEach(id => {
                const view = document.getElementById(`tb-subview-${id}`);
                const btn = document.getElementById(`tb-nav-${id}`);
                if (view) view.classList.toggle('hidden', id !== subId);
                if (btn) btn.classList.toggle('active', id === subId);
            });

            if (subId === 'dashboard') renderTabunganDashboardView();
            if (subId === 'transaksi') renderTabunganTransaksiView();
            if (subId === 'sumber') renderTabunganSumberView();
            if (subId === 'grafik') renderTabunganGrafikView();
        }

        function renderTabungan() {
            switchTabunganSub(appState.activeTabunganSub || 'dashboard');
        }

        function renderTabunganDashboardView() {
            const data = getUserData().tabungan || { sources: [], transactions: [] };
            const transactions = data.transactions || [];
            const sources = data.sources || [];

            document.getElementById('tb-user-greeting').innerText = getUserData().profile.name || appState.currentUser || 'sam';

            let totalSaldo = 0, totalMasukBulan = 0, totalKeluarBulan = 0;
            const now = new Date();

            transactions.forEach(t => {
                const amount = Number(t.amount || 0);
                if (t.type === 'Nabung') totalSaldo += amount;
                else totalSaldo -= amount;

                const d = new Date(t.timestamp);
                if (d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear()) {
                    if (t.type === 'Nabung') totalMasukBulan += amount;
                    else totalKeluarBulan += amount;
                }
            });

            document.getElementById('tb-dash-total-saldo').innerText = 'Rp ' + totalSaldo.toLocaleString('id-ID');
            document.getElementById('tb-dash-pemasukan-bulan').innerText = 'Rp ' + totalMasukBulan.toLocaleString('id-ID');
            document.getElementById('tb-dash-pengeluaran-bulan').innerText = 'Rp ' + totalKeluarBulan.toLocaleString('id-ID');

            renderTabunganBarChart('tb-dash-chart-bars', transactions, 7);

            const sourcesBox = document.getElementById('tb-dash-sources-preview');
            sourcesBox.innerHTML = '';
            if (!sources.length) {
                sourcesBox.innerHTML = '<p class="text-xs text-slate-400 italic">Belum ada sumber dana.</p>';
            } else {
                sources.slice(0, 3).forEach(src => {
                    let sal = 0;
                    transactions.filter(t => t.source === src).forEach(t => {
                        sal += (t.type === 'Nabung' ? Number(t.amount || 0) : -Number(t.amount || 0));
                    });
                    sourcesBox.innerHTML += `
                        <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100 text-xs">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded bg-emerald-100 text-emerald-700 flex items-center justify-center text-[10px]"><i class="fa-solid fa-wallet"></i></div>
                                <span class="font-bold text-slate-800">${src}</span>
                            </div>
                            <span class="font-extrabold text-slate-900">Rp ${sal.toLocaleString('id-ID')}</span>
                        </div>`;
                });
            }

            const recentBox = document.getElementById('tb-dash-recent-list');
            recentBox.innerHTML = '';
            const recent = transactions.slice(0, 5);
            if (!recent.length) {
                recentBox.innerHTML = '<tr><td colspan="5" class="py-6 text-center text-slate-400">Belum ada transaksi.</td></tr>';
            } else {
                recent.forEach(item => {
                    const isNabung = item.type === 'Nabung';
                    recentBox.innerHTML += `
                        <tr class="hover:bg-slate-50">
                            <td class="py-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold ${isNabung?'bg-emerald-50 text-emerald-700':'bg-rose-50 text-rose-600'}">${isNabung?'Pemasukan':'Pengeluaran'}</span></td>
                            <td class="py-3 font-medium text-slate-800">${item.source}</td>
                            <td class="py-3 text-slate-400">${item.date}</td>
                            <td class="py-3 font-bold ${isNabung?'text-emerald-600':'text-slate-900'}">${isNabung?'+':'-'} Rp ${item.amount.toLocaleString('id-ID')}</td>
                            <td class="py-3 text-right">
                                <button onclick="deleteTransaction(${item.id})" class="px-2.5 py-1 text-rose-500 bg-rose-50 hover:bg-rose-100 rounded-lg text-[11px] font-semibold">Hapus</button>
                            </td>
                        </tr>`;
                });
            }
        }

        function renderTabunganTransaksiView() {
            const data = getUserData().tabungan;
            const tbody = document.getElementById('transaction-table-body');
            const emptyEl = document.getElementById('transaction-empty');
            if (!tbody) return;
            tbody.innerHTML = '';
            if (!data.transactions.length) {
                if (emptyEl) emptyEl.classList.remove('hidden');
            } else {
                if (emptyEl) emptyEl.classList.add('hidden');
                data.transactions.forEach(item => {
                    const isNabung = item.type === 'Nabung';
                    tbody.innerHTML += `
                        <tr class="hover:bg-slate-50">
                            <td class="p-4 font-medium text-slate-900">${item.date}</td>
                            <td class="p-4"><span class="px-2.5 py-1 rounded-lg text-xs font-semibold ${isNabung?'bg-emerald-50 text-emerald-700':'bg-rose-50 text-rose-600'}">${isNabung?'Nabung':'Narik'}</span></td>
                            <td class="p-4">${item.source}</td>
                            <td class="p-4 font-bold ${isNabung?'text-emerald-600':'text-rose-600'}">${isNabung?'+':'-'}Rp ${item.amount.toLocaleString('id-ID')}</td>
                            <td class="p-4 text-right space-x-2">
                                <button onclick="openTransactionModal(${item.id})" class="text-emerald-600 hover:text-emerald-800"><i class="fa-regular fa-pen-to-square"></i></button>
                                <button onclick="deleteTransaction(${item.id})" class="text-rose-500 hover:text-rose-700"><i class="fa-regular fa-trash-can"></i></button>
                            </td>
                        </tr>`;
                });
            }
        }

        function renderTabunganSumberView() {
            const data = getUserData().tabungan;
            const sources = data.sources || [];
            const transactions = data.transactions || [];

            const cardsContainer = document.getElementById('tb-sumber-cards-container');
            const detailsList = document.getElementById('tb-sumber-details-list');
            cardsContainer.innerHTML = '';
            detailsList.innerHTML = '';

            if (!sources.length) {
                cardsContainer.innerHTML = '<p class="col-span-full text-center text-xs text-slate-400 py-8">Belum ada sumber dana.</p>';
                return;
            }

            let totalSemua = 0;
            sources.forEach(src => {
                let bal = 0;
                transactions.filter(t => t.source === src).forEach(t => bal += (t.type === 'Nabung' ? Number(t.amount||0) : -Number(t.amount||0)));
                totalSemua += bal;
            });

            sources.forEach(src => {
                let bal = 0;
                transactions.filter(t => t.source === src).forEach(t => bal += (t.type === 'Nabung' ? Number(t.amount||0) : -Number(t.amount||0)));
                const porsi = totalSemua > 0 ? Math.round((bal / totalSemua) * 100) : 0;

                cardsContainer.innerHTML += `
                    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col justify-between">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-slate-400 uppercase">Tabungan</span>
                            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs"><i class="fa-solid fa-wallet"></i></div>
                        </div>
                        <div class="mt-4">
                            <h3 class="text-2xl font-extrabold text-slate-900">Rp ${bal.toLocaleString('id-ID')}</h3>
                            <p class="text-xs font-semibold text-slate-500 mt-1">${src}</p>
                        </div>
                    </div>`;

                detailsList.innerHTML += `
                    <div class="p-4 rounded-xl border border-slate-200 bg-slate-50 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 text-emerald-600 flex items-center justify-center font-bold text-sm"><i class="fa-solid fa-wallet"></i></div>
                            <div>
                                <h4 class="text-sm font-bold text-slate-900">${src}</h4>
                                <p class="text-xs text-slate-400">Tabungan · ${porsi}% dari total saldo</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-sm font-extrabold text-slate-900 block">Rp ${bal.toLocaleString('id-ID')}</span>
                            <button onclick="deleteSource('${src}')" class="text-xs text-rose-500 hover:underline">Hapus</button>
                        </div>
                    </div>`;
            });
        }

        function renderTabunganGrafikView() {
            const data = getUserData().tabungan || { sources: [], transactions: [] };
            const transactions = data.transactions || [];
            const sources = data.sources || [];

            let totalMasuk = 0, totalKeluar = 0;
            transactions.forEach(t => {
                if (t.type === 'Nabung') totalMasuk += Number(t.amount||0);
                else totalKeluar += Number(t.amount||0);
            });

            const rasio = totalMasuk > 0 ? Math.max(0, Math.round(((totalMasuk - totalKeluar) / totalMasuk) * 100)) : 100;

            document.getElementById('tb-grafik-rasio').innerText = rasio + '%';
            document.getElementById('tb-grafik-total-tx').innerText = transactions.length;
            document.getElementById('tb-grafik-sumber-aktif').innerText = sources.length;

            renderTabunganBarChart('tb-grafik-chart-full', transactions, 7);
        }

        function renderTabunganBarChart(containerId, transactions, monthsCount) {
            const container = document.getElementById(containerId);
            if (!container) return;
            const now = new Date();
            const points = Array.from({length: monthsCount}, (_, i) => {
                const d = new Date(now.getFullYear(), now.getMonth() - (monthsCount - 1) + i, 1);
                return {
                    label: d.toLocaleDateString('id-ID', { month: 'short' }),
                    month: d.getMonth(),
                    year: d.getFullYear(),
                    masuk: 0,
                    keluar: 0
                };
            });

            transactions.forEach(t => {
                const d = new Date(t.timestamp);
                const idx = points.findIndex(p => p.month === d.getMonth() && p.year === d.getFullYear());
                if (idx >= 0) {
                    if (t.type === 'Nabung') points[idx].masuk += Number(t.amount||0);
                    else points[idx].keluar += Number(t.amount||0);
                }
            });

            const max = Math.max(1, ...points.flatMap(p => [p.masuk, p.keluar]));

            container.innerHTML = `
                <div class="grid grid-cols-7 gap-2 items-end h-40 pt-4">
                    ${points.map(p => `
                        <div class="flex h-full flex-col items-center justify-end gap-2">
                            <div class="flex h-full w-full items-end justify-center gap-1">
                                <div title="Pemasukan: Rp ${p.masuk.toLocaleString('id-ID')}" class="w-3 rounded-t bg-emerald-600" style="height:${Math.max(4, (p.masuk/max)*100)}%"></div>
                                <div title="Pengeluaran: Rp ${p.keluar.toLocaleString('id-ID')}" class="w-3 rounded-t bg-amber-600" style="height:${Math.max(4, (p.keluar/max)*100)}%"></div>
                            </div>
                            <span class="text-[11px] font-semibold text-slate-500">${p.label}</span>
                        </div>
                    `).join('')}
                </div>`;
        }

        function renderSimpleChart(containerId, list, key, monthsCount, labelName) {
            const container = document.getElementById(containerId);
            if (!container) return;
            const now = new Date();
            const points = Array.from({length: monthsCount}, (_, i) => {
                const d = new Date(now.getFullYear(), now.getMonth() - (monthsCount - 1) + i, 1);
                return {
                    label: d.toLocaleDateString('id-ID', { month: 'short' }),
                    month: d.getMonth(),
                    year: d.getFullYear(),
                    val: 0
                };
            });

            list.forEach(item => {
                const d = new Date(item.timestamp);
                const idx = points.findIndex(p => p.month === d.getMonth() && p.year === d.getFullYear());
                if (idx >= 0) points[idx].val += Number(item[key] || 0);
            });

            const max = Math.max(1, ...points.map(p => p.val));

            container.innerHTML = `
                <div class="grid grid-cols-7 gap-3 items-end h-40 pt-4">
                    ${points.map(p => `
                        <div class="flex h-full flex-col items-center justify-end gap-2">
                            <div class="flex h-full w-full items-end justify-center">
                                <div title="${labelName}: ${p.val}" class="w-5 rounded-t-md bg-emerald-600" style="height:${Math.max(6, (p.val/max)*100)}%"></div>
                            </div>
                            <span class="text-[11px] font-semibold text-slate-500">${p.label}</span>
                        </div>
                    `).join('')}
                </div>`;
        }

        /* --- SOURCES & TRANSACTIONS MODAL LOGIC --- */
        function openSourceModal() {
            document.getElementById('modal-source').classList.remove('hidden');
            renderManageSources();
        }
        function closeSourceModal() {
            document.getElementById('modal-source').classList.add('hidden');
            renderTabungan();
        }

        function renderManageSources() {
            const container = document.getElementById('sources-list-manage');
            container.innerHTML = '';
            const sources = getUserData().tabungan.sources;
            if (!sources.length) {
                container.innerHTML = '<div class="p-5 text-center text-xs text-slate-500 bg-slate-50 rounded-xl border border-dashed border-slate-300">Belum ada sumber dana.</div>';
            }
            sources.forEach((src, idx) => {
                container.innerHTML += `
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-xs flex items-center justify-between">
                        <input type="text" value="${src}" id="source-name-input-${idx}" class="px-2 py-1 bg-white border border-slate-200 rounded text-xs font-semibold w-2/3">
                        <div class="space-x-1">
                            <button onclick="updateSourceName(${idx})" class="text-emerald-600 font-bold px-1">Simpan</button>
                            <button onclick="deleteSource('${src}')" class="text-rose-500 px-1"><i class="fa-regular fa-trash-can"></i></button>
                        </div>
                    </div>`;
            });
        }

        function updateSourceName(index) {
            const newName = document.getElementById(`source-name-input-${index}`).value.trim();
            if (newName) {
                const oldName = getUserData().tabungan.sources[index];
                getUserData().tabungan.sources[index] = newName;
                getUserData().tabungan.transactions.forEach(t => { if (t.source === oldName) t.source = newName; });
                saveAppData();
                renderManageSources();
                renderTabungan();
            }
        }

        function saveNewSource(e) {
            e.preventDefault();
            const val = document.getElementById('new-source-name').value.trim();
            if (val && !getUserData().tabungan.sources.includes(val)) {
                getUserData().tabungan.sources.push(val);
                saveAppData();
                document.getElementById('new-source-name').value = '';
                renderManageSources();
                renderTabungan();
            }
        }

        function deleteSource(src) {
            const tab = getUserData().tabungan;
            tab.sources = tab.sources.filter(s => s !== src);
            saveAppData();
            renderManageSources();
            renderTabungan();
        }

        function openTransactionModal(editId = null) {
            document.getElementById('modal-transaction').classList.remove('hidden');
            document.getElementById('transaction-form').reset();
            document.getElementById('transaction-edit-id').value = '';
            document.getElementById('transaction-modal-title').innerText = "Tambah Transaksi Keuangan";

            const select = document.getElementById('t-source');
            select.innerHTML = '';
            getUserData().tabungan.sources.forEach(s => select.innerHTML += `<option value="${s}">${s}</option>`);

            if (editId !== null) {
                const item = getUserData().tabungan.transactions.find(x => x.id === editId);
                if (item) {
                    document.getElementById('transaction-edit-id').value = item.id;
                    document.getElementById('t-type').value = item.type;
                    document.getElementById('t-source').value = item.source;
                    document.getElementById('t-amount').value = item.amount;
                    document.getElementById('transaction-modal-title').innerText = "Edit Transaksi Keuangan";
                }
            }
        }
        function closeTransactionModal() { document.getElementById('modal-transaction').classList.add('hidden'); }

        function saveTransaction(e) {
            e.preventDefault();
            const editId = document.getElementById('transaction-edit-id').value;
            const record = {
                id: editId ? Number(editId) : Date.now(),
                date: new Date().toLocaleDateString('id-ID', { day:'numeric', month:'short', year:'numeric' }),
                timestamp: Date.now(),
                type: document.getElementById('t-type').value,
                source: document.getElementById('t-source').value,
                amount: parseFloat(document.getElementById('t-amount').value)
            };

            const transactions = getUserData().tabungan.transactions;
            if (editId) {
                const idx = transactions.findIndex(x => x.id == editId);
                if (idx !== -1) transactions[idx] = record;
            } else {
                transactions.unshift(record);
            }

            saveAppData();
            closeTransactionModal();
            renderTabungan();
        }

        function deleteTransaction(id) {
            if (confirm("Hapus transaksi ini?")) {
                getUserData().tabungan.transactions = getUserData().tabungan.transactions.filter(x => x.id !== id);
                saveAppData();
                renderTabungan();
            }
        }

        /* --- PENGATURAN --- */
        function handlePhotoUpload(event) {
            const files = event.target.files;
            if (!files || files.length === 0) return;
            appState.tempUploadedPhotos = [];
            const previewBox = document.getElementById('settings-photos-preview');
            previewBox.innerHTML = '';

            Array.from(files).forEach(file => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const result = e.target.result;
                    appState.tempUploadedPhotos.push(result);
                    previewBox.innerHTML += `<div class="h-16 rounded border overflow-hidden"><img src="${result}" class="w-full h-full object-cover"></div>`;
                };
                reader.readAsDataURL(file);
            });
        }

        function loadSettingsForm() {
            document.getElementById('settings-account-username').textContent = appState.currentUser || '-';
            const p = getUserData().profile;
            document.getElementById('settings-name').value = p.name || '';
            document.getElementById('settings-education').value = p.education || '';
            document.getElementById('settings-target').value = p.target || '';
            document.getElementById('settings-dreams').value = p.dreams || '';
            appState.tempUploadedPhotos = p.photos || [];
            
            const previewBox = document.getElementById('settings-photos-preview');
            previewBox.innerHTML = '';
            (p.photos || []).forEach(src => {
                previewBox.innerHTML += `<div class="h-16 rounded border overflow-hidden"><img src="${src}" class="w-full h-full object-cover"></div>`;
            });
        }

        function saveSettings(e) {
            e.preventDefault();
            const p = getUserData().profile;
            p.name = document.getElementById('settings-name').value.trim();
            p.education = document.getElementById('settings-education').value.trim();
            p.target = document.getElementById('settings-target').value.trim();
            p.dreams = document.getElementById('settings-dreams').value.trim();
            p.photos = appState.tempUploadedPhotos;

            saveAppData();
            alert("Profil berhasil disimpan!");
            switchTab('overview');
        }

        function resetProfileData() {
            if (confirm("Reset data profil?")) {
                getUserData().profile = { name: "Hisyam", education: "", target: "", dreams: "", photos: [] };
                saveAppData();
                loadSettingsForm();
                renderOverview();
            }
        }
    </script>
