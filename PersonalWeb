    <!-- SCRIPT LOGIC -->
    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyDfmOSt0dis0JCB9vzviRXrv3afs7xXO50",
            authDomain: "personal-web-59cff.firebaseapp.com",
            projectId: "personal-web-59cff",
            storageBucket: "personal-web-59cff.firebasestorage.app",
            messagingSenderId: "436593096672",
            appId: "1:436593096672:web:c8aec9e7b92771aab39d85",
            measurementId: "G-V00W9GWQ4V"
        };

        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const db = firebase.firestore();
        let appState = {
            isLoginMode: true,
            currentUser: null,
            users: JSON.parse(localStorage.getItem('mutabaah_cloud_users')) || {},
            activeTab: 'overview',
            activeMutabaahSub: 'dashboard',
            activeWorkoutSub: 'dashboard',
            activeTabunganSub: 'dashboard',
            mutabaahFilter: 'week',
            workoutFilter: 'week',
            tempUploadedPhotos: []
        };

        function getEmptyUserData() {
            return {
                profile: { name: "", education: "", target: "", dreams: "", photos: [] },
                mutabaah: [],
                workout: { types: [], logs: [] },
                tabungan: { sources: ['sendiri'], transactions: [] }
            };
        }

        function normalizeUserData(savedData) {
            const defaults = getEmptyUserData();
            const data = (savedData && typeof savedData === 'object') ? savedData : {};
            const profile = (data.profile && typeof data.profile === 'object') ? data.profile : {};
            const workout = (data.workout && typeof data.workout === 'object') ? data.workout : {};
            const tabungan = (data.tabungan && typeof data.tabungan === 'object') ? data.tabungan : {};
            const sources = Array.isArray(tabungan.sources) && tabungan.sources.length ? tabungan.sources : ['sendiri'];
            return {
                ...defaults,
                ...data,
                profile: { ...defaults.profile, ...profile, photos: Array.isArray(profile.photos) ? profile.photos : [] },
                mutabaah: Array.isArray(data.mutabaah) ? data.mutabaah : [],
                workout: {
                    ...defaults.workout, ...workout,
                    types: Array.isArray(workout.types) ? workout.types : [],
                    logs: Array.isArray(workout.logs) ? workout.logs : []
                },
                tabungan: {
                    ...defaults.tabungan, ...tabungan,
                    sources,
                    transactions: Array.isArray(tabungan.transactions) ? tabungan.transactions : []
                }
            };
        }

        window.onload = async function() {
            auth.onAuthStateChanged(async (firebaseUser) => {
                if (!firebaseUser) {
                    appState.currentUser = null;
                    showAuth();
                    return;
                }
                try {
                    const snap = await db.collection('users').doc(firebaseUser.uid).get();
                    if (!snap.exists) {
                        await auth.signOut();
                        showAuth();
                        return;
                    }
                    const cloud = snap.data();
                    const username = cloud.username || firebaseUser.email.split('@')[0];
                    appState.currentUser = username;
                    appState.firebaseUid = firebaseUser.uid;
                    appState.users[username] = { data: normalizeUserData(cloud.data) };
                    localStorage.setItem('mutabaah_cloud_current_user', username);
                    showDashboard();
                } catch (error) {
                    console.error(error);
                    showAuth();
                }
            });
        };

        function usernameToEmail(username) {
            return username.trim().toLowerCase() + '@personal-web-59cff.firebaseapp.com';
        }

        function toggleAuthMode() {
            appState.isLoginMode = !appState.isLoginMode;
            document.getElementById('auth-title').innerText = appState.isLoginMode ? "Mutabaah.cloud" : "Buat Akun Baru";
            document.getElementById('auth-subtitle').innerText = appState.isLoginMode ? "Masuk untuk melanjutkan ke personal dashboard Anda" : "Daftar untuk mulai mencatat mutabaah dan keuangan";
            document.getElementById('auth-submit-btn').querySelector('span').innerText = appState.isLoginMode ? "Masuk" : "Daftar & Masuk";
            document.getElementById('auth-switch-text').innerText = appState.isLoginMode ? "Belum punya akun?" : "Sudah punya akun?";
            document.getElementById('auth-switch-btn').innerText = appState.isLoginMode ? "Buat Akun" : "Masuk";
            document.getElementById('auth-error').classList.add('hidden');
        }

        function togglePasswordVisibility() {
            const input = document.getElementById('auth-password');
            const icon = document.getElementById('password-eye-icon');
            if (!input) return;
            input.type = input.type === 'password' ? 'text' : 'password';
            if (icon) icon.className = input.type === 'password' ? 'fa-regular fa-eye' : 'fa-regular fa-eye-slash';
        }

        async function handleAuth(e) {
            e.preventDefault();
            const username = document.getElementById('auth-username').value.trim();
            const password = document.getElementById('auth-password').value;
            const errEl = document.getElementById('auth-error');
            const submitBtn = document.getElementById('auth-submit-btn');
            if (!username || !password) return;

            submitBtn.disabled = true;
            errEl.classList.add('hidden');
            try {
                const email = usernameToEmail(username);
                if (appState.isLoginMode) {
                    const credential = await auth.signInWithEmailAndPassword(email, password);
                    const snap = await db.collection('users').doc(credential.user.uid).get();
                    if (!snap.exists) {
                        await auth.signOut();
                        throw new Error('Data akun tidak ditemukan.');
                    }
                    const cloud = snap.data();
                    appState.currentUser = cloud.username || username;
                    appState.firebaseUid = credential.user.uid;
                    appState.users[appState.currentUser] = { data: normalizeUserData(cloud.data) };
                    localStorage.setItem('mutabaah_cloud_current_user', appState.currentUser);
                    showDashboard();
                } else {
                    const credential = await auth.createUserWithEmailAndPassword(email, password);
                    const data = getEmptyUserData();
                    await db.collection('users').doc(credential.user.uid).set({
                        username: username,
                        data: data,
                        createdAt: firebase.firestore.FieldValue.serverTimestamp()
                    });
                    appState.currentUser = username;
                    appState.firebaseUid = credential.user.uid;
                    appState.users[username] = { data };
                    localStorage.setItem('mutabaah_cloud_current_user', username);
                    showDashboard();
                }
            } catch (error) {
                console.error(error);
                errEl.innerText = error.message || 'Gagal masuk. Coba lagi.';
                errEl.classList.remove('hidden');
            } finally {
                submitBtn.disabled = false;
            }
        }

        async function logout() {
            try {
                await auth.signOut();
                appState.currentUser = null;
                appState.firebaseUid = null;
                localStorage.removeItem('mutabaah_cloud_current_user');
                showAuth();
            } catch (error) {
                alert('Gagal keluar akun.');
            }
        }

        function showAuth() {
