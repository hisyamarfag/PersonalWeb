<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mutabaah.cloud - Personal Dashboard & Tracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: { 50:'#ecfdf5', 100:'#d1fae5', 500:'#10b981', 600:'#059669', 700:'#047857', 800:'#065f46', 900:'#064e3b' }
                    },
                    fontFamily: { sans: ['Plus Jakarta Sans', 'sans-serif'] }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root { --brand:#059669; --canvas:#f8fafc; }
        body { font-family:'Plus Jakarta Sans',sans-serif; background:var(--canvas); color:#0f172a; }
        ::-webkit-scrollbar { width:6px; height:6px; }
        ::-webkit-scrollbar-thumb { background:#cbd5e1; border-radius:99px; }
        .app-sidebar { background:linear-gradient(180deg,#0f172a 0%,#1e293b 100%); color:#cbd5e1; }
        .brand-mark { background:linear-gradient(135deg,#10b981,#047857); }
        .nav-btn { border-radius:12px!important; margin:3px 0; padding:12px 14px!important; gap:12px; color:#94a3b8!important; }
        .nav-btn:hover { color:#fff!important; background:rgba(255,255,255,.08)!important; }
        .nav-btn.nav-active { color:#fff!important; background:linear-gradient(90deg,rgba(16,185,129,.24),rgba(16,185,129,.10))!important; box-shadow:inset 3px 0 #10b981; }
        .surface-card { background:#fff; border:1px solid #e2e8f0; border-radius:18px; }
        .btn-primary { background:#059669!important; color:#fff!important; }
        .btn-primary:hover { background:#047857!important; }
        
        /* Subnav Pills for All Dynamic Tabs (Tabungan, Mutabaah, Workout) */
        .subnav-pill-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            color: #64748b;
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            transition: all 0.2s ease;
            white-space: nowrap;
        }
        .subnav-pill-btn:hover {
            color: #059669;
            background: #ecfdf5;
            border-color: #a7f3d0;
        }
        .subnav-pill-btn.active {
            color: #ffffff;
            background: #059669;
            border-color: #059669;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);
        }

        .settings-branch { box-shadow: 0 5px 20px rgba(15,23,42,.035); }
        .settings-branch-title { display:flex; align-items:center; gap:12px; padding:17px 18px; cursor:pointer; list-style:none; }
        .settings-branch-title::-webkit-details-marker { display:none; }
        .settings-branch-title strong { display:block; font-size:14px; color:#0f172a; }
        .settings-branch-title small { display:block; margin-top:3px; font-size:11px; color:#64748b; font-weight:400; }
        .settings-branch-icon { width:40px; height:40px; border-radius:13px; display:flex; align-items:center; justify-content:center; background:#ecfdf5; color:#059669; flex-shrink:0; }
        
        .context-subnav { display:flex; align-items:center; gap:8px; padding:10px 20px; background:#fff; border-bottom:1px solid #e2e8f0; overflow-x:auto; scrollbar-width:thin; }
        .context-subnav:empty { display:none; }
        .context-subnav button { flex:0 0 auto; display:inline-flex; align-items:center; gap:7px; white-space:nowrap; border:1px solid #dbe3ec; background:#f8fafc; color:#334155; padding:8px 12px; border-radius:10px; font-size:12px; font-weight:700; transition:all .15s ease; }
        .context-subnav button:hover { background:#ecfdf5; border-color:#a7f3d0; color:#047857; }

        @media (max-width: 767px) {
            #app { min-height:100dvh; height:auto; position:relative; overflow-x:hidden; }
            #auth-view { position:fixed !important; inset:0 !important; z-index:9999 !important; background:#f8fafc !important; }
            #dashboard-view { display:flex !important; flex-direction:column !important; min-height:100dvh; position:relative; }
            #dashboard-view > .app-sidebar {
                position:fixed !important; bottom:0 !important; left:0 !important; right:0 !important; top:auto !important;
                z-index:40 !important; width:100% !important; height:auto !important; flex-direction:row !important;
                justify-content:space-around !important; padding:6px 4px max(6px,env(safe-area-inset-bottom)) !important;
                background:#1e293b !important; border-radius:16px 16px 0 0 !important; box-shadow:0 -4px 16px rgba(0,0,0,0.15);
            }
            #dashboard-view > .app-sidebar > *:not(nav) { display:none !important; }
            #dashboard-view > .app-sidebar nav { display:flex !important; flex-direction:row !important; width:100% !important; justify-content:space-around !important; }
            #dashboard-view .app-sidebar .nav-btn { flex:1 !important; flex-direction:column !important; padding:6px 2px !important; font-size:9px !important; text-align:center !important; }
            #dashboard-view .app-sidebar .nav-btn i { font-size:16px !important; }
            #dashboard-view > main { padding-bottom:84px !important; flex:1 1 auto; overflow-y:auto; }
            .tab-content { padding:12px !important; }
        }

        #overview-profile-card {
            position:relative; min-height:190px; overflow:hidden; align-items:flex-end !important; padding:22px !important; color:#fff;
            background:linear-gradient(120deg,rgba(15,23,42,.75),rgba(15,23,42,.3)), var(--profile-cover, linear-gradient(135deg,#059669,#0f172a)) !important;
            background-size:cover !important; background-position:center !important;
        }
    </style>
</head>
<body class="text-slate-900 h-full flex flex-col">

    <div id="app" class="flex-1 flex flex-col h-full overflow-hidden">
        
        <!-- AUTHENTICATION VIEW (ISOLATED & FULLSCREEN ON MOBILE) -->
        <div id="auth-view" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-gradient-to-br from-slate-100 via-white to-emerald-50 overflow-y-auto">
            <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-slate-200 p-6 sm:p-8 my-auto">
                <div class="text-center mb-6">
                    <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl brand-mark text-white mb-3 text-xl shadow-lg">
                        <i class="fa-solid fa-seedling"></i>
                    </div>
                    <h1 class="text-2xl font-bold text-slate-900" id="auth-title">Mutabaah.cloud</h1>
                    <p class="text-xs text-slate-500 mt-1" id="auth-subtitle">Masuk untuk mengelola mutabaah dan tracker Anda</p>
                </div>

                <form id="auth-form" onsubmit="handleAuth(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-600 mb-1">Username</label>
                        <input type="text" id="auth-username" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-600 mb-1">Password</label>
                        <div class="relative">
                            <input type="password" id="auth-password" required autocomplete="current-password" class="w-full px-4 py-2.5 pr-12 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <button type="button" onclick="togglePasswordVisibility()" aria-label="Lihat atau sembunyikan password" class="absolute inset-y-0 right-0 px-4 text-slate-500 hover:text-emerald-700"><i id="password-eye-icon" class="fa-regular fa-eye"></i></button>
                        </div>
                    </div>
                    <div id="auth-error" class="text-xs text-rose-500 hidden text-center font-medium"></div>
                    <button type="submit" id="auth-submit-btn" class="w-full py-3 btn-primary font-semibold rounded-xl text-sm flex items-center justify-center gap-2">
                        <span>Masuk</span><i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                </form>

                <div class="mt-6 text-center">
                    <p class="text-xs text-slate-500">
                        <span id="auth-switch-text">Belum punya akun?</span>
                        <button type="button" onclick="toggleAuthMode()" class="font-semibold text-emerald-600 hover:underline ml-1" id="auth-switch-btn">Buat Akun</button>
                    </p>
                </div>
            </div>
        </div>

        <!-- MAIN DASHBOARD VIEW -->
        <div id="dashboard-view" class="flex-1 flex flex-col md:flex-row h-full overflow-hidden hidden">
            
            <!-- SIDEBAR (BOTTOM BAR ON MOBILE) -->
            <aside class="app-sidebar w-full md:w-64 flex md:flex-col justify-between z-20 order-last md:order-first shrink-0">
                <div class="p-6 hidden md:block">
                    <div class="flex items-center gap-3">
                        <div class="brand-mark w-10 h-10 rounded-xl text-white flex items-center justify-center">
                            <i class="fa-solid fa-seedling"></i>
                        </div>
                        <div>
                            <h2 class="font-bold text-sm text-white">Mutabaah.cloud</h2>
                            <p class="text-[11px] text-emerald-400" id="current-user-display">-</p>
                        </div>
                    </div>
                </div>

                <nav class="flex md:flex-col justify-around md:justify-start md:px-3 flex-1 py-1 md:py-0">
                    <button onclick="switchTab('overview')" id="nav-overview" class="nav-btn nav-active flex flex-col md:flex-row items-center px-3 py-2 text-xs md:text-sm font-semibold transition w-full">
                        <i class="fa-solid fa-chart-pie text-base text-emerald-400"></i><span>Ringkasan</span>
                    </button>
                    <button onclick="switchTab('mutabaah')" id="nav-mutabaah" class="nav-btn flex flex-col md:flex-row items-center px-3 py-2 text-xs md:text-sm font-semibold transition w-full">
                        <i class="fa-solid fa-mosque text-base text-emerald-400"></i><span>Mutabaah</span>
                    </button>
                    <button onclick="switchTab('workout')" id="nav-workout" class="nav-btn flex flex-col md:flex-row items-center px-3 py-2 text-xs md:text-sm font-semibold transition w-full">
                        <i class="fa-solid fa-dumbbell text-base text-sky-400"></i><span>Workout</span>
                    </button>
                    <button onclick="switchTab('tabungan')" id="nav-tabungan" class="nav-btn flex flex-col md:flex-row items-center px-3 py-2 text-xs md:text-sm font-semibold transition w-full">
                        <i class="fa-solid fa-wallet text-base text-amber-400"></i><span>Tabungan</span>
                    </button>
                    <button onclick="switchTab('pengaturan')" id="nav-pengaturan" class="nav-btn flex flex-col md:flex-row items-center px-3 py-2 text-xs md:text-sm font-semibold transition w-full">
                        <i class="fa-solid fa-gear text-base text-violet-400"></i><span>Pengaturan</span>
                    </button>
                </nav>

                <div class="p-4 hidden md:block border-t border-white/10">
                    <button onclick="logout()" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-rose-300 hover:bg-white/10 transition">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i><span>Keluar Akun</span>
                    </button>
                </div>
            </aside>

            <!-- MAIN CONTENT AREA -->
            <main class="flex-1 min-w-0 overflow-y-auto bg-slate-50 flex flex-col">
                <header class="bg-white/90 backdrop-blur border-b border-slate-200 px-4 md:px-8 py-3.5 flex items-center justify-between sticky top-0 z-10">
                    <div>
                        <p class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest">DASHBOARD PRIBADI</p>
                        <h1 id="topbar-title" class="text-base md:text-lg font-bold text-slate-800">Ringkasan & Profil</h1>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-xs" id="topbar-avatar">H</div>
                    </div>
                </header>

                <nav id="context-subnav" aria-label="Submenu" class="context-subnav" role="navigation"></nav>

                <!-- TAB 1: RINGKASAN & PROFIL -->
                <section id="tab-overview" class="tab-content p-4 md:p-8 space-y-6">
                    <div id="overview-profile-card" class="bg-white p-6 rounded-2xl border border-slate-200 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-sm">
                        <div class="flex items-center gap-4">
                            <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-xl font-extrabold border-2 border-white shadow overflow-hidden">
                                <span id="profile-initials-main">H</span>
                            </div>
                            <div>
                                <span class="px-2 py-0.5 bg-emerald-50 text-emerald-700 text-[10px] font-bold rounded uppercase">Profil Aktif</span>
                                <h2 class="text-xl font-bold text-slate-900 mt-1" id="profile-name-main">Hisyam</h2>
                                <p class="text-xs text-slate-500 mt-0.5" id="profile-bio-main">-</p>
                            </div>
                        </div>
                        <button onclick="switchTab('pengaturan')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold flex items-center gap-2">
                            <i class="fa-regular fa-pen-to-square"></i><span>Edit Profil & Foto</span>
                        </button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="bg-white p-5 rounded-2xl border border-slate-200 space-y-1">
                            <span class="text-xs font-bold text-emerald-600 uppercase">Pendidikan</span>
                            <p class="text-sm font-semibold text-slate-800" id="display-education">-</p>
                        </div>
                        <div class="bg-white p-5 rounded-2xl border border-slate-200 space-y-1">
                            <span class="text-xs font-bold text-amber-600 uppercase">Target Utama</span>
                            <p class="text-sm font-semibold text-slate-800" id="display-target">-</p>
                        </div>
                        <div class="bg-white p-5 rounded-2xl border border-slate-200 space-y-1">
                            <span class="text-xs font-bold text-sky-600 uppercase">Mimpi & Cita-cita</span>
                            <p class="text-sm font-semibold text-slate-800" id="display-dreams">-</p>
                        </div>
                    </div>
                </section>

                <!-- TAB 2: MUTABAAH -->
                <section id="tab-mutabaah" class="tab-content p-4 md:p-8 space-y-6 hidden">
                    <div class="flex items-center gap-2 border-b border-slate-200 pb-3 overflow-x-auto">
                        <button onclick="switchMutabaahSub('dashboard')" id="mb-nav-dashboard" class="subnav-pill-btn active">
                            <i class="fa-solid fa-gauge-high"></i> Dashboard
                        </button>
                        <button onclick="switchMutabaahSub('riwayat')" id="mb-nav-riwayat" class="subnav-pill-btn">
                            <i class="fa-solid fa-clock-rotate-left"></i> Riwayat
                        </button>
                        <button onclick="switchMutabaahSub('rekapan')" id="mb-nav-rekapan" class="subnav-pill-btn">
                            <i class="fa-solid fa-square-poll-vertical"></i> Rekapan
                        </button>
                        <button onclick="switchMutabaahSub('grafik')" id="mb-nav-grafik" class="subnav-pill-btn">
                            <i class="fa-solid fa-chart-line"></i> Grafik
                        </button>
                    </div>

                    <!-- SUBVIEW 1: DASHBOARD MUTABAAH -->
                    <div id="mb-subview-dashboard" class="space-y-6">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <div>
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider" id="mb-current-date-display">28 OKTOBER 2026</span>
                                <h1 class="text-2xl font-bold text-slate-900 mt-0.5">Mutabaah Yaumiyah 🌙</h1>
                            </div>
                            <button onclick="openMutabaahModal()" class="px-5 py-2.5 btn-primary rounded-xl text-xs font-bold flex items-center justify-center gap-2 shadow-sm">
                                <i class="fa-solid fa-plus"></i><span>+ Catat hari ini</span>
                            </button>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                            <div class="bg-gradient-to-br from-emerald-600 to-emerald-800 text-white rounded-2xl p-6 shadow-md relative overflow-hidden">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-medium text-emerald-100">Capaian Jamaah</span>
                                    <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center text-xs"><i class="fa-solid fa-mosque"></i></div>
                                </div>
                                <h3 class="text-3xl font-extrabold mt-4" id="mb-dash-jamaah-total">0 Waktu</h3>
                                <p class="text-[11px] text-emerald-100/80 mt-2">Target utama 5 waktu sehari</p>
                            </div>

                            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col justify-between">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-semibold text-slate-500">Ibadah Malam & Dhuha</span>
                                    <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs"><i class="fa-solid fa-moon font-bold"></i></div>
                                </div>
                                <div class="mt-4">
                                    <h3 class="text-2xl font-extrabold text-slate-900" id="mb-dash-malam-dhuha">0 Malam / 0 Dhuha</h3>
                                    <p class="text-[11px] text-emerald-600 font-medium mt-1">✓ Konsistensi sholat sunnah</p>
                                </div>
                            </div>

                            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col justify-between">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-semibold text-slate-500">Total Tilawah</span>
                                    <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs"><i class="fa-solid fa-book-quran font-bold"></i></div>
                                </div>
                                <div class="mt-4">
                                    <h3 class="text-2xl font-extrabold text-slate-900" id="mb-dash-tilawah-total">0 Halaman</h3>
                                    <p class="text-[11px] text-slate-400 font-medium mt-1" id="mb-dash-tilawah-last">Halaman terakhir: -</p>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                            <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="text-base font-bold text-slate-800">Perkembangan Sholat Berjamaah</h3>
                                    <span class="text-xs text-slate-400">7 bulan terakhir</span>
                                </div>
                                <div id="mb-dash-chart-bars" class="min-h-[180px]"></div>
                            </div>

                            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between space-y-4">
                                <div>
                                    <div class="flex items-center justify-between mb-4">
                                        <h3 class="text-base font-bold text-slate-800">Rekapan 7 Hari Terakhir</h3>
                                        <button onclick="switchMutabaahSub('rekapan')" class="text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1.5 rounded-lg hover:bg-emerald-100">Detail ↗</button>
                                    </div>
                                    <div id="mb-dash-quick-recap" class="grid grid-cols-2 gap-3"></div>
                                </div>
                                <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-500">
                                    <strong class="text-slate-800 block mb-0.5">Istiqomah Ibadah.</strong>
                                    Perbaiki ibadah wajib dan hidupkan ibadah sunnah.
                                </div>
                            </div>
                        </div>

                        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
                            <div class="flex items-center justify-between">
                                <h3 class="text-base font-bold text-slate-800">Catatan terbaru</h3>
                                <button onclick="switchMutabaahSub('riwayat')" class="text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1.5 rounded-lg hover:bg-emerald-100">Lihat semua ↗</button>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="w-full text-left text-xs text-slate-600">
                                    <thead class="text-slate-400 uppercase font-bold border-b border-slate-100">
                                        <tr>
                                            <th class="pb-3">TANGGAL</th>
                                            <th class="pb-3">JAMAAH</th>
                                            <th class="pb-3">MALAM</th>
                                            <th class="pb-3">DHUHA</th>
                                            <th class="pb-3">TILAWAH</th>
                                            <th class="pb-3 text-right">AKSI</th>
                                        </tr>
                                    </thead>
                                    <tbody id="mb-dash-recent-list" class="divide-y divide-slate-100"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- SUBVIEW 2: RIWAYAT MUTABAAH -->
                    <div id="mb-subview-riwayat" class="space-y-6 hidden">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <div>
                                <h1 class="text-2xl font-bold text-slate-900">Riwayat Mutabaah</h1>
                                <p class="text-xs text-slate-500">Seluruh riwayat pencatatan amalan ibadah harian.</p>
                            </div>
                            <button onclick="openMutabaahModal()" class="px-5 py-2.5 btn-primary rounded-xl text-xs font-bold flex items-center justify-center gap-2 shadow-sm">
                                <i class="fa-solid fa-plus"></i><span>+ Catat hari ini</span>
                            </button>
                        </div>

                        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
                            <div class="p-5 border-b border-slate-200 flex items-center justify-between">
                                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-700">Daftar Lengkap</h2>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="w-full text-left text-xs text-slate-600">
                                    <thead class="bg-slate-50 text-slate-600 uppercase font-semibold border-b border-slate-200">
                                        <tr>
                                            <th class="p-4">Tanggal</th>
                                            <th class="p-4">Jamaah</th>
                                            <th class="p-4">Malam</th>
                                            <th class="p-4">Dhuha</th>
                                            <th class="p-4">Puasa</th>
                                            <th class="p-4">Rawatib</th>
                                            <th class="p-4">Dzikir</th>
                                            <th class="p-4">Tilawah</th>
                                            <th class="p-4 text-right">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody id="mutabaah-table-body" class="divide-y divide-slate-100"></tbody>
                                </table>
                            </div>
                            <div id="mutabaah-empty" class="p-8 text-center text-xs text-slate-500 hidden">Belum ada data mutabaah.</div>
