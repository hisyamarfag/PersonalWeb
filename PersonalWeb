        function saveAppData() {
            localStorage.setItem('mutabaah_cloud_users', JSON.stringify(appState.users));
            if (!appState.currentUser || !appState.firebaseUid || !appState.users[appState.currentUser]) return;
            const payload = {
                username: appState.currentUser,
                data: appState.users[appState.currentUser].data,
                updatedAt: firebase.firestore.FieldValue.serverTimestamp()
            };
            db.collection('users').doc(appState.firebaseUid).set(payload, { merge: true })
              .catch(error => console.error('Gagal simpan cloud:', error));
        }

        function getUserData() {
            if (!appState.currentUser || !appState.users[appState.currentUser]) {
